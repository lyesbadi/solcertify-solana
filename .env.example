# SolCertify - Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs

# ===========================================
# Configuration Solana
# ===========================================
SOLANA_NETWORK=devnet
PROGRAM_ID=FspmA7UoptTCbR1oq1Rd5iHg737gTeKCRfZwfJtj7Fjb

# Pour développement local (Docker ou localhost)
SOLANA_RPC_URL=http://localhost:8899
# Pour devnet: https://api.devnet.solana.com
# Pour mainnet: https://api.mainnet-beta.solana.com

# ===========================================
# Configuration Pinata IPFS
# ===========================================
# Obtenez vos clés sur https://app.pinata.cloud/keys
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# ===========================================
# Frontend (Vite)
# ===========================================
# En Docker, utiliser les noms de service
VITE_SOLANA_RPC_URL=http://localhost:8899
VITE_IPFS_API_URL=http://localhost:3001

# En Docker Compose:
# VITE_SOLANA_RPC_URL=http://solana-backend:8899
# VITE_IPFS_API_URL=http://ipfs-service:3001
