# Dockerfile pour le backend Solana
FROM rust:1.75-slim

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    libudev-dev \
    git \
    wget \
    bc \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Installer Solana CLI via GitHub Release (Méthode manuelle plus robuste)
RUN wget -q https://github.com/solana-labs/solana/releases/download/v1.18.4/solana-release-x86_64-unknown-linux-gnu.tar.bz2 \
    && tar jxf solana-release-x86_64-unknown-linux-gnu.tar.bz2 \
    && rm solana-release-x86_64-unknown-linux-gnu.tar.bz2 \
    && mkdir -p /root/.local/share/solana/install \
    && mv solana-release /root/.local/share/solana/install/active_release

# Ajouter Solana au PATH
ENV PATH="/root/.local/share/solana/install/active_release/bin:$PATH"

# Vérifier l'installation
RUN solana --version

# Installer Anchor CLI
RUN cargo install --git https://github.com/coral-xyz/anchor --tag v0.29.0 anchor-cli --locked

# Installer Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Créer le répertoire de l'application
WORKDIR /app

# Copier les fichiers du projet
# Copier les fichiers du projet
COPY Cargo.toml Cargo.lock ./
COPY Anchor.toml ./
COPY programs ./programs
COPY tests ./tests
COPY scripts ./scripts
COPY package.json package-lock.json tsconfig.json ./

# Copier les fichiers .env si présents
COPY .env* ./

# Installer les dépendances Node.js
RUN npm install

# Configurer Solana pour localhost
RUN solana config set --url localhost && \
    solana-keygen new --no-bip39-passphrase -o /root/.config/solana/id.json

# Exposer les ports
EXPOSE 8899 8900 9900

# Rendre les scripts exécutables
RUN chmod +x scripts/*.sh

# Script de démarrage utilisant full_pipeline.sh
COPY scripts/start-backend.sh /start-backend.sh
RUN chmod +x /start-backend.sh

CMD ["/start-backend.sh"]
